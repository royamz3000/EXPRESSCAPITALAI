# Form submissions are delivered by email via https://formsubmit.co.
#
# These have sensible defaults baked into the code, so the form works without
# setting anything. Override them here (or in your Hostinger environment
# settings) if the destination addresses ever change.
#
# LEAD_EMAIL is the primary recipient. FormSubmit requires a one-time
# activation: the first submission triggers a confirmation email to this
# address with an "Activate" link that must be clicked once.
LEAD_EMAIL=roy@businesscapitalllc.com

# Comma-separated additional recipients (CC).
LEAD_EMAIL_CC=john@expresscapital.ai,melissa@expresscapital.ai
