# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.eslintcache
.playwright-cli/

# next.js
/.next/
/out/

# production
/build
/output

# misc
.DS_Store
Thumbs.db
*.pem
*.key
.idea/
.vscode/
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files; only the documented template is safe to commit
.env*
!.env.example

# hosting-provider local state
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts
